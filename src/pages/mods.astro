---
import Base from '../layouts/Base.astro';
import { SERVER, PACK } from '../consts.ts';


const packCategories = [
  {
    id: 'performance',
    icon: '\u26A1',
    name: 'Performance',
    blurb: 'The reason the pack exists. On most machines these together are worth several times your vanilla frame rate.',
    mods: [
      ['Sodium', 'Complete rendering engine rewrite \u2014 the single biggest FPS gain.'],
      ['Sodium Extra', 'Extra toggles for Sodium: particles, fog, weather, animations.'],
      ["Reese's Sodium Options", 'A far more usable video settings screen for Sodium.'],
      ['Lithium', 'Optimises game logic and tick performance without changing behaviour.'],
      ['FerriteCore', 'Cuts memory usage substantially, especially with big worlds.'],
      ['ImmediatelyFast', 'Speeds up HUD, GUI and text rendering.'],
      ['EntityCulling', "Skips rendering entities you can't actually see."],
      ['MoreCulling', 'Culls hidden block faces \u2014 helps a lot in built-up areas.'],
      ['Dynamic FPS', 'Drops frame rate when the window is unfocused. Saves battery and heat.'],
      ['Debugify', 'Fixes a long list of vanilla bugs Mojang has left open.'],
    ],
  },
  {
    id: 'visual',
    icon: '\u{1F3A8}',
    name: 'Visuals & Shaders',
    blurb: 'Everything that changes how the world looks. All optional \u2014 turn off what your GPU dislikes.',
    mods: [
      ['Iris Shaders', 'Shader support, works alongside Sodium. BSL, Complementary and Solas are included.'],
      ['Distant Horizons', 'Renders terrain far past your view distance. This is what shows the pregenerated world.'],
      ['LambDynamicLights', 'Held torches and glowing items actually light up the world.'],
      ['Continuity', 'Connected textures \u2014 glass and bookshelves stop looking like grids.'],
      ['Entity Model Features', 'Support for custom entity models from resource packs.'],
      ['Entity Texture Features', 'Custom and random entity textures. Powers Fresh Animations.'],
      ['Animatica', 'Animated textures from OptiFine-format resource packs.'],
      ['OptiGUI', 'Lets resource packs restyle GUIs.'],
      ['BetterGrassify', 'OptiFine-style better grass on block sides.'],
      ['Skyboxify', 'Custom skyboxes from resource packs.'],
      ['Puzzle', 'Resource pack extras \u2014 panoramas, shader toggles, and more.'],
      ['Capes', 'Shows capes from OptiFine, LabyMod and similar.'],
      ['Model Gap Fix', 'Removes the hairline gaps in item and block models.'],
    ],
  },
  {
    id: 'hud',
    icon: '\u{1F4CA}',
    name: 'HUD & Interface',
    blurb: 'Information on screen that vanilla leaves out.',
    mods: [
      ['Jade', "Shows what block or mob you're looking at, and its state."],
      ['AppleSkin', 'Food saturation and hunger values on the hunger bar.'],
      ['Armor HUD', 'Armour durability at a glance.'],
      ['Better Mount HUD', 'Proper health and jump bars when riding.'],
      ['Roughly Enough Items', 'Recipe and usage lookup for every item.'],
      ['Inventory Sorting', 'Sort chests and inventories with a click.'],
      ['Paginated Advancements', 'Makes the advancement screen usable.'],
      ['More Chat History', 'Keeps far more chat scrollback than vanilla.'],
      ['Mod Menu', 'In-game list and config screens for every mod.'],
      ["Completionist's Index", 'Tracks what you have and have not collected.'],
      ['Remove Reloading Screen', 'Stops the world freezing on resource pack reloads.'],
      ['Language Reload', 'Faster language switching and reloads.'],
      ['Main Menu Credits', 'Small main menu tweak.'],
    ],
  },
  {
    id: 'utility',
    icon: '\u{1F9F0}',
    name: 'Utility & Quality of Life',
    blurb: 'Tools you end up using constantly without thinking about them.',
    mods: [
      ["Xaero's Minimap", 'Minimap with waypoints and death markers.'],
      ["Xaero's World Map", 'Full explorable world map, pairs with the minimap.'],
      ['Zoomify', 'Configurable zoom on a keybind.'],
      ['Freecam', 'Detach the camera to look around. Client-side only.'],
      ['Fabrishot', 'Screenshots far above your screen resolution.'],
      ['Client Tweaks', 'A pile of small annoyances, individually toggleable.'],
      ['Client Commands', 'Client-side commands that never touch the server.'],
      ['Controlify', 'Full controller support.'],
      ['FastQuit', 'Return to the menu without waiting for the save.'],
      ['AFK Cinematic', 'Slow cinematic camera while you are AFK.'],
      ['e4mc', 'Share a singleplayer world with friends in one click.'],
      ['No Chat Reports', 'Removes chat reporting and message signing.'],
      ['Crash Assistant', 'Explains crashes in plain language.'],
      ['MixinTrace', 'Adds mod names to crash reports so problems are traceable.'],
      ['YOSBR', 'Ships sensible default settings without overwriting yours.'],
    ],
  },
  {
    id: 'packs',
    icon: '\u{1F5BC}',
    name: 'Resource & Shader Packs',
    blurb: '17 resource packs and 3 shader packs, all included and switchable in-game.',
    mods: [
      ['Fresh Animations', 'Reworked mob animations \u2014 the big visual one.'],
      ['Better Leaves', 'Fuller, bushier foliage.'],
      ['Fancy Crops', 'Nicer crop models.'],
      ['Fast Better Grass', 'Lightweight better-grass look.'],
      ['New Glowing Ores', 'Ores that stand out underground.'],
      ['Enchant Icons / Even Better Enchants', 'Readable enchantment display.'],
      ['Unique Dark, Default Dark Mode, Mandalas GUI', 'Dark interface themes.'],
      ['Immersive Interfaces, Icon Fresh, Low Shield, Low on Fire', 'Cleaner HUD and menus.'],
      ['Fresh Animations Extensions', 'Add-ons for Fresh Animations.'],
      ['BSL / Complementary Unbound / Solas', 'Three shader packs, ready to switch between.'],
    ],
  },
  {
    id: 'libs',
    icon: '\u{1F517}',
    name: 'Libraries',
    blurb: 'Required by the mods above. Nothing to configure.',
    mods: [
      ['Fabric API', ''],
      ['Fabric Language Kotlin', ''],
      ['Architectury API', ''],
      ['Balm', ''],
      ['Cloth Config', ''],
      ['YetAnotherConfigLib', ''],
      ['Forge Config API Port', ''],
      ['Puzzles Lib', ''],
      ['CWB', ''],
    ],
  },
];

const packHighlights = [
  { i:'🌄', n:'Distant Horizons ' + PACK.dhVersion, d:'Matches the server exactly. This is what lets you see the pregenerated world at distance.' },
  { i:'⚡', n:'Sodium + Iris',        d:'Rendering rewrite plus shader support. Large FPS gain over vanilla.' },
  { i:'🎨', n:'3 shader packs',       d:'Complementary Unbound, BSL and Solas, ready to switch between.' },
  { i:'🗺', n:"Xaero's Minimap & Map", d:'Minimap with waypoints and a full world map.' },
  { i:'🔎', n:'Jade + REI + AppleSkin', d:'Block info, recipe lookup and food values.' },
  { i:'🧊', n:'Lithium + FerriteCore', d:'The same optimisation stack the server runs, on your side.' },
  { i:'📸', n:'Zoomify, Freecam, Fabrishot', d:'Zoom, free camera and high-resolution screenshots.' },
  { i:'🌙', n:'Resource packs',       d:'Dark UI, better leaves, fresh animations — all optional.' },
];

const perf = [
  { i:'⚡', n:'Sodium',          d:'Complete rendering rewrite. The single biggest FPS gain available.', u:'https://modrinth.com/mod/sodium' },
  { i:'🧊', n:'Lithium',         d:'Optimises game logic without changing behaviour.', u:'https://modrinth.com/mod/lithium' },
  { i:'🧠', n:'FerriteCore',     d:'Cuts memory usage substantially.', u:'https://modrinth.com/mod/ferrite-core' },
  { i:'🚀', n:'ImmediatelyFast', d:'Speeds up UI and HUD rendering.', u:'https://modrinth.com/mod/immediatelyfast' },
  { i:'👁', n:'EntityCulling',   d:'Skips rendering entities you cannot see.', u:'https://modrinth.com/mod/entityculling' },
  { i:'📦', n:'ModernFix',       d:'Faster startup and lower memory use.', u:'https://modrinth.com/mod/modernfix' },
];
const qol = [
  { i:'🗺', n:"Xaero's Minimap", d:'Minimap with waypoints. Pairs with the World Map.', u:'https://modrinth.com/mod/xaeros-minimap' },
  { i:'🔍', n:'Zoomify',         d:'Optifine-style zoom on a keybind.', u:'https://modrinth.com/mod/zoomify' },
  { i:'🍗', n:'AppleSkin',       d:'Shows food saturation and hunger values.', u:'https://modrinth.com/mod/appleskin' },
  { i:'🔎', n:'Jade',            d:'Displays info about whatever you are looking at.', u:'https://modrinth.com/mod/jade' },
  { i:'⚙', n:'Mod Menu',        d:'In-game list and config for all your mods.', u:'https://modrinth.com/mod/modmenu' },
  { i:'🎒', n:'Inventory Sorting', d:'Sorting and auto-refill for your inventory.', u:'https://modrinth.com/mod/inventory-profiles-next' },
];
const visual = [
  { i:'🌄', n:'Distant Horizons', d:'See the pregenerated world at huge distance. Must be ' + PACK.dhVersion + ' to match the server.', u:'https://modrinth.com/mod/distanthorizons' },
  { i:'🌅', n:'Iris Shaders',    d:'Shader support. Works alongside Sodium.', u:'https://modrinth.com/mod/iris' },
  { i:'🎵', n:'Simple Voice Chat', d:'Proximity voice chat. Ask before installing — needs a server tunnel.', u:'https://modrinth.com/mod/simple-voice-chat' },
];
---
<Base title="Mods — GibbSux" desc="Recommended modpack and client-side mods for the GibbSux server.">
  <section class="wrap">
    <div class="section-head">
      <span class="eyebrow">CLIENT MODS</span>
      <h2>Mods</h2>
      <p class="lead">The server runs performance mods only. You can install whatever
      client-side mods you like — they need nothing on our end.</p>
    </div>

    <!-- ===== recommended pack ===== -->
    <div id="modpack" class="addrbox" style="max-width:100%;text-align:left;margin-bottom:16px">
      <div class="lbl">WE RECOMMEND</div>
      <h3 style="font-size:22px;margin-bottom:8px">The {PACK.name} Pack v{PACK.version}</h3>
      <p class="muted" style="font-size:15px;margin-bottom:18px">
        Our recommended setup for this server: {PACK.modCount} mods and resource packs, already
        configured, including the exact Distant Horizons build we run. No content mods, so it
        can't get you kicked. One download instead of picking through the lists below.
      </p>
      <p class="small muted" style="margin-bottom:18px">
        Minecraft {SERVER.mcVersion} · Fabric {SERVER.loaderVersion} · {PACK.size}
      </p>
      <a class="btn btn-p" href={PACK.file} download>⬇ Download .mrpack</a>
      <a class="btn btn-g" href="https://modrinth.com/app" target="_blank" rel="noopener" style="margin-left:8px">Get Modrinth App</a>
    </div>

    <div class="card-flat accent-amber" style="margin-bottom:34px">
      <h3>⚠ Please read</h3>
      <p class="muted small">
        This is <b>not an official Modrinth modpack</b> and it is not affiliated with, endorsed by
        or supported by Mojang, Modrinth, or any of the mod authors. It is a collection put
        together and edited by the GibbSux team for use on this server.<br/><br/>
        Every mod inside belongs to its own author and is distributed under its own licence — all
        credit goes to them. Configs and resource pack selections have been changed from their
        defaults to suit this server.<br/><br/>
        Use it at your own risk. If something breaks, tell <b>us</b> on Discord — please don't
        report pack issues to the individual mod authors, since the problem is far more likely to
        be our configuration than their mod. You're never required to use it: vanilla Fabric works
        fine, and so does any set of client-side mods you pick yourself.
      </p>
    </div>

    <div class="section-head">
      <h2 style="font-size:24px">What's in the pack</h2>
      <p class="muted small">{PACK.modCount} files: 60 mods, 17 resource packs, 3 shader packs. Click a category to expand.</p>
    </div>

    <div style="margin-bottom:26px">
      {packCategories.map(cat => (
        <details>
          <summary>
            <span>{cat.icon} <b>{cat.name}</b> <span class="muted small">({cat.mods.length})</span></span>
          </summary>
          <p class="muted small" style="margin-top:10px">{cat.blurb}</p>
          <div class="grid g2" style="margin-top:14px">
            {cat.mods.map(([n, d]) => (
              <div class="mod" style="padding:11px 14px">
                <span><b>{n}</b>{d && <span>{d}</span>}</span>
              </div>
            ))}
          </div>
        </details>
      ))}
    </div>

    <div class="card-flat" style="margin-bottom:44px">
      <h3>Installing it</h3>
      <div class="step">
        <div class="step-n">1</div>
        <div class="step-b"><h3>Install the Modrinth App</h3>
        <p>Free, and it handles Fabric and Java for you.
        <a href="https://modrinth.com/app" target="_blank" rel="noopener">modrinth.com/app</a></p></div>
      </div>
      <div class="step">
        <div class="step-n">2</div>
        <div class="step-b"><h3>Open the .mrpack</h3>
        <p>Double-click it, or in the app choose <b>Add instance → From file</b>.
        All {PACK.modCount} files download automatically.</p></div>
      </div>
      <div class="step">
        <div class="step-n">3</div>
        <div class="step-b"><h3>Give it 6GB+ RAM</h3>
        <p>Instance settings → Memory. Distant Horizons needs the headroom — on the default 2GB
        you'll stutter badly and blame the server.</p></div>
      </div>
      <div class="step">
        <div class="step-n">4</div>
        <div class="step-b"><h3>Add the server</h3>
        <p>Multiplayer → Add Server → <code style="color:var(--orange)">{SERVER.address}</code></p></div>
      </div>
    </div>

    <!-- ===== rolling your own ===== -->
    <div class="section-head">
      <span class="eyebrow">OR PICK YOUR OWN</span>
      <h2 style="font-size:26px">Building it yourself</h2>
    </div>

    <div class="grid g2" style="margin-bottom:44px">
      <div class="card accent-green">
        <h3>✅ Client-side mods — always fine</h3>
        <p>Rendering, UI, sound, minimaps, shaders, zoom. These change only what
        <i>you</i> see, so the server neither knows nor cares.</p>
      </div>
      <div class="card accent-red">
        <h3>❌ Content mods — will kick you</h3>
        <p>Anything adding blocks, items, entities, dimensions or recipes. Create,
        Farmer's Delight, Twilight Forest, Alex's Mobs and similar. These must exist on
        the server too, at identical versions.</p>
      </div>
    </div>

    <div class="section-head"><h2 style="font-size:24px">⚡ Performance</h2>
      <p class="muted small">Install these first. On a mid-range PC they can triple your frame rate.</p></div>
    <div class="grid g2" style="margin-bottom:44px">
      {perf.map(m => (
        <a class="mod" href={m.u} target="_blank" rel="noopener">
          <span class="mod-i">{m.i}</span>
          <span><b>{m.n}</b><span>{m.d}</span></span>
        </a>
      ))}
    </div>

    <div class="section-head"><h2 style="font-size:24px">🎯 Quality of life</h2>
      <p class="muted small">Not required, but most people end up with all of these.</p></div>
    <div class="grid g2" style="margin-bottom:44px">
      {qol.map(m => (
        <a class="mod" href={m.u} target="_blank" rel="noopener">
          <span class="mod-i">{m.i}</span>
          <span><b>{m.n}</b><span>{m.d}</span></span>
        </a>
      ))}
    </div>

    <div class="section-head"><h2 style="font-size:24px">🎨 Visual</h2>
      <p class="muted small">Heavier. Lovely on a strong GPU, painful on a laptop.</p></div>
    <div class="grid g2" style="margin-bottom:44px">
      {visual.map(m => (
        <a class="mod" href={m.u} target="_blank" rel="noopener">
          <span class="mod-i">{m.i}</span>
          <span><b>{m.n}</b><span>{m.d}</span></span>
        </a>
      ))}
    </div>

    <div class="card-flat accent-amber">
      <h3>Want a content modpack?</h3>
      <p class="muted small">Content mods can be added — but they have to go on the server
      and on every player's client at matching versions, and the world may need regenerating.
      If enough people want a pack, ask on Discord and it can be arranged for a fresh season.</p>
      <div class="btn-row" style="justify-content:flex-start;margin-top:18px">
        <a href={SERVER.discord} class="btn btn-dc" target="_blank" rel="noopener">Suggest a modpack</a>
      </div>
    </div>
  </section>
</Base>
